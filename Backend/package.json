{
  "name": "kaamgar-api",
  "version": "1.0.0",
  "private": true,
  "description": "KaamGar backend: PostgreSQL, authentication, role-based access control and cooperative management",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
